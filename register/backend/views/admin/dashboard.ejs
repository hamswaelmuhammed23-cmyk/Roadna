<%- include('../partials/head', { title: title || 'Admin Dashboard - Roadna', hasNavbar: true }) %>
<%- include('../partials/navbar', { user: typeof user !== 'undefined' ? user : null }) %>

<div class="container container-full" style="margin-top: 100px;">
  <div class="page-header">
    <div style="margin-bottom: 15px;">
      <a href="/" class="btn btn-secondary" style="width: auto;">
        <i class="fas fa-arrow-left"></i> Back to Home
      </a>
    </div>
    <h1><i class="fas fa-shield-alt" style="color: #f7971e;"></i> Admin Dashboard</h1>
    <p style="font-size: 16px; color: #555; margin-top: 10px;">
      Manage users, trips, events, and platform statistics
    </p>
  </div>

  <!-- Statistics Cards -->
  <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 40px;">
    <div class="stat-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 25px; border-radius: 12px; color: white; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
          <h3 style="margin: 0; font-size: 32px; font-weight: bold;" id="totalUsers">-</h3>
          <p style="margin: 5px 0 0 0; opacity: 0.9;">Total Users</p>
        </div>
        <i class="fas fa-users" style="font-size: 40px; opacity: 0.8;"></i>
      </div>
    </div>

    <div class="stat-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); padding: 25px; border-radius: 12px; color: white; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
          <h3 style="margin: 0; font-size: 32px; font-weight: bold;" id="totalTrips">-</h3>
          <p style="margin: 5px 0 0 0; opacity: 0.9;">Total Trips</p>
        </div>
        <i class="fas fa-route" style="font-size: 40px; opacity: 0.8;"></i>
      </div>
    </div>

    <div class="stat-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); padding: 25px; border-radius: 12px; color: white; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
          <h3 style="margin: 0; font-size: 32px; font-weight: bold;" id="totalEvents">-</h3>
          <p style="margin: 5px 0 0 0; opacity: 0.9;">Total Events</p>
        </div>
        <i class="fas fa-calendar-alt" style="font-size: 40px; opacity: 0.8;"></i>
      </div>
    </div>

    <div class="stat-card" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); padding: 25px; border-radius: 12px; color: white; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
          <h3 style="margin: 0; font-size: 32px; font-weight: bold;" id="activeUsers">-</h3>
          <p style="margin: 5px 0 0 0; opacity: 0.9;">Active Users</p>
        </div>
        <i class="fas fa-user-check" style="font-size: 40px; opacity: 0.8;"></i>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="quick-actions" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 40px;">
    <a href="/admin/users<%= typeof token !== 'undefined' && token ? '?token=' + token : '' %>" class="action-btn" style="display: block; padding: 20px; background: #fff; border: 2px solid #f7971e; border-radius: 8px; text-align: center; text-decoration: none; color: #2b3a55; transition: all 0.3s;">
      <i class="fas fa-users" style="font-size: 32px; color: #f7971e; margin-bottom: 10px;"></i>
      <h3 style="margin: 10px 0 5px 0;">Manage Users</h3>
      <p style="margin: 0; color: #666; font-size: 14px;">View, edit, delete users</p>
    </a>

    <a href="/admin/trips<%= typeof token !== 'undefined' && token ? '?token=' + token : '' %>" class="action-btn" style="display: block; padding: 20px; background: #fff; border: 2px solid #f7971e; border-radius: 8px; text-align: center; text-decoration: none; color: #2b3a55; transition: all 0.3s;">
      <i class="fas fa-route" style="font-size: 32px; color: #f7971e; margin-bottom: 10px;"></i>
      <h3 style="margin: 10px 0 5px 0;">Manage Trips</h3>
      <p style="margin: 0; color: #666; font-size: 14px;">View, edit, delete trips</p>
    </a>

    <a href="/admin/events<%= typeof token !== 'undefined' && token ? '?token=' + token : '' %>" class="action-btn" style="display: block; padding: 20px; background: #fff; border: 2px solid #f7971e; border-radius: 8px; text-align: center; text-decoration: none; color: #2b3a55; transition: all 0.3s;">
      <i class="fas fa-calendar-alt" style="font-size: 32px; color: #f7971e; margin-bottom: 10px;"></i>
      <h3 style="margin: 10px 0 5px 0;">Manage Events</h3>
      <p style="margin: 0; color: #666; font-size: 14px;">View, edit, delete events</p>
    </a>
  </div>

  <!-- Additional Stats -->
  <div class="additional-stats" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
    <div style="background: #fff; padding: 20px; border-radius: 8px; border: 1px solid #e0e0e0;">
      <h4 style="margin: 0 0 10px 0; color: #2b3a55;">Trip Participants</h4>
      <p style="margin: 0; font-size: 24px; font-weight: bold; color: #f7971e;" id="tripParticipants">-</p>
    </div>
    <div style="background: #fff; padding: 20px; border-radius: 8px; border: 1px solid #e0e0e0;">
      <h4 style="margin: 0 0 10px 0; color: #2b3a55;">Event Participants</h4>
      <p style="margin: 0; font-size: 24px; font-weight: bold; color: #f7971e;" id="eventParticipants">-</p>
    </div>
    <div style="background: #fff; padding: 20px; border-radius: 8px; border: 1px solid #e0e0e0;">
      <h4 style="margin: 0 0 10px 0; color: #2b3a55;">Open Trips</h4>
      <p style="margin: 0; font-size: 24px; font-weight: bold; color: #f7971e;" id="openTrips">-</p>
    </div>
    <div style="background: #fff; padding: 20px; border-radius: 8px; border: 1px solid #e0e0e0;">
      <h4 style="margin: 0 0 10px 0; color: #2b3a55;">Active Events</h4>
      <p style="margin: 0; font-size: 24px; font-weight: bold; color: #f7971e;" id="activeEvents">-</p>
    </div>
  </div>
</div>

<script>
const token = '<%= typeof token !== "undefined" ? token : "" %>';

// Load dashboard statistics
async function loadDashboardStats() {
  try {
    const response = await fetch('/api/v1/admin/dashboard', {
      headers: {
        'Authorization': `Bearer ${token}`
      }
    });

    if (!response.ok) {
      throw new Error('Failed to load statistics');
    }

    const result = await response.json();
    if (result.success) {
      const stats = result.data;
      document.getElementById('totalUsers').textContent = stats.totalUsers;
      document.getElementById('totalTrips').textContent = stats.totalTrips;
      document.getElementById('totalEvents').textContent = stats.totalEvents;
      document.getElementById('activeUsers').textContent = stats.activeUsers;
      document.getElementById('tripParticipants').textContent = stats.totalTripParticipants;
      document.getElementById('eventParticipants').textContent = stats.totalEventParticipants;
      document.getElementById('openTrips').textContent = stats.openTrips;
      document.getElementById('activeEvents').textContent = stats.activeEvents;
    }
  } catch (error) {
    console.error('Error loading dashboard stats:', error);
  alert('Failed to load dashboard statistics. Please refresh the page.');
  }
}

// Load stats on page load
loadDashboardStats();

// Add hover effects to action buttons
document.querySelectorAll('.action-btn').forEach(btn => {
  btn.addEventListener('mouseenter', function() {
    this.style.transform = 'translateY(-5px)';
    this.style.boxShadow = '0 6px 12px rgba(247, 151, 30, 0.3)';
  });
  btn.addEventListener('mouseleave', function() {
    this.style.transform = 'translateY(0)';
    this.style.boxShadow = 'none';
  });
});
</script>

<%- include('../partials/scripts') %>

